{
  "name": "sap-federal-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/standalone.mjs",
    "preview": "vite preview",
    "test": "playwright test",
    "test:data": "python3 -m unittest discover -s tests -p test_*.py",
    "refresh": "python3 scripts/snapshot.py --download",
    "test:build": "node scripts/check-build.mjs",
    "refresh:rfp": "python3 scripts/rfp.py --download --documents"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.10.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@vitejs/plugin-react": "^4.2.0",
    "vite": "^5.0.0"
  }
}