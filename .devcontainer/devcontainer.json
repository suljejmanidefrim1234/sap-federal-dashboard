{
  "name": "Private federal account dashboard",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "remoteUser": "node",
  "hostRequirements": { "cpus": 2 },
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "Private SAP federal dashboard",
      "onAutoForward": "openBrowser",
      "protocol": "http"
    }
  },
  "postCreateCommand": "npm ci",
  "postStartCommand": "bash .devcontainer/start-dashboard.sh"
}
